{
  "realm": "toolmesh",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "user",
        "description": "Standard toolmesh caller"
      },
      {
        "name": "admin",
        "description": "Toolmesh administrator"
      }
    ],
    "client": {
      "downstream-service": [
        {
          "name": "access",
          "description": "May call the downstream service"
        }
      ],
      "mcp-datetime": [
        {
          "name": "access",
          "description": "May call the datetime MCP server"
        }
      ]
    }
  },
  "defaultRole": {
    "name": "default-roles-toolmesh",
    "composite": true,
    "clientRole": false
  },
  "clients": [
    {
      "clientId": "toolmesh-cli",
      "name": "Toolmesh CLI / dev client (human flow)",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": [
        "http://localhost:8000/*",
        "http://localhost:3000/*",
        "http://localhost:5173/*"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "toolmesh-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "toolmesh",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "toolmesh-agent",
      "name": "Toolmesh service client (client credentials flow)",
      "enabled": true,
      "publicClient": false,
      "secret": "toolmesh-agent-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "toolmesh-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "toolmesh",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "toolmesh",
      "name": "Toolmesh (browser login, authorization code + PKCE, password/refresh grants, token exchange)",
      "enabled": true,
      "publicClient": false,
      "secret": "toolmesh-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/*",
        "standard.token.exchange.enabled": "true"
      },
      "redirectUris": [
        "http://localhost:8010/api/auth/callback"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "protocolMappers": [
        {
          "name": "toolmesh-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "toolmesh",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ],
      "fullScopeAllowed": false
    },
    {
      "clientId": "downstream-service",
      "name": "Mock downstream service (exchange target)",
      "enabled": true,
      "publicClient": false,
      "secret": "downstream-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "mcp-datetime",
      "name": "Datetime MCP server (exchange target)",
      "enabled": true,
      "publicClient": false,
      "secret": "mcp-datetime-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    }
  ],
  "users": [
    {
      "username": "user",
      "email": "user@toolmesh.local",
      "firstName": "Test",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "user",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user"
      ],
      "clientRoles": {
        "downstream-service": [
          "access"
        ],
        "mcp-datetime": [
          "access"
        ]
      }
    },
    {
      "username": "admin",
      "email": "admin@toolmesh.local",
      "firstName": "Test",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        {
          "type": "password",
          "value": "admin",
          "temporary": false
        }
      ],
      "realmRoles": [
        "user",
        "admin"
      ],
      "clientRoles": {
        "downstream-service": [
          "access"
        ],
        "mcp-datetime": [
          "access"
        ]
      }
    },
    {
      "username": "service-account-toolmesh-agent",
      "enabled": true,
      "serviceAccountClientId": "toolmesh-agent",
      "realmRoles": [
        "user"
      ],
      "clientRoles": {
        "downstream-service": [
          "access"
        ],
        "mcp-datetime": [
          "access"
        ]
      }
    }
  ],
  "scopeMappings": [
    {
      "client": "toolmesh-cli",
      "roles": [
        "user",
        "admin"
      ]
    },
    {
      "client": "toolmesh",
      "roles": [
        "user",
        "admin"
      ]
    },
    {
      "client": "toolmesh-agent",
      "roles": [
        "user",
        "admin"
      ]
    }
  ],
  "clientScopeMappings": {
    "downstream-service": [
      {
        "client": "toolmesh",
        "roles": [
          "access"
        ]
      }
    ],
    "mcp-datetime": [
      {
        "client": "toolmesh",
        "roles": [
          "access"
        ]
      }
    ]
  }
}
